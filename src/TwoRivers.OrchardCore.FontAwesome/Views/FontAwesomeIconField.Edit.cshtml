@model TwoRivers.Berelain.ViewModels.BerelainIconFieldEditViewModel
@inject OrchardCore.ResourceManagement.IResourceManager ResourceManager
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Register picker assets (deduplicated by Orchard when multiple fields are on the page).
    ResourceManager.RegisterResource("stylesheet", "BerelainIconPicker");
    ResourceManager.RegisterResource("script", "BerelainIconPicker").AtFoot();

    // The admin editor does not run through the front-end theme layout, so the picker
    // must load Font Awesome explicitly. Always use the vendored full library here:
    // admin correctness is more important than front-end-oriented subset savings.
    if (!string.IsNullOrWhiteSpace(Model.IconLibraryCssUrl))
    {
        ResourceManager.RegisterLink(new OrchardCore.ResourceManagement.LinkEntry
        {
            Rel = "stylesheet",
            Href = Model.IconLibraryCssUrl
        });
    }

    // Unique ID used to wire the field shell to its modal without conflicts when
    // multiple BerelainIconField instances are present on the same page.
    var fieldId = Html.IdFor(m => m.IconKey);
    var modalId = "fa-picker-modal-" + fieldId;

    var hasValue = !string.IsNullOrEmpty(Model.IconKey);

    // Size dropdown options. Labels match Font Awesome documentation.
    var sizeOptions = new List<SelectListItem>
    {
        new("Default (inherit)", ""),
        new("Extra Small (fa-2xs)", "fa-2xs"),
        new("Small (fa-xs)",       "fa-xs"),
        new("Slightly Small (fa-sm)", "fa-sm"),
        new("Large (fa-lg)",       "fa-lg"),
        new("Extra Large (fa-xl)", "fa-xl"),
        new("2\u00d7 Extra Large (fa-2xl)", "fa-2xl"),
    };

    // Color dropdown options. Bootstrap semantic text-color classes only.
    var colorOptions = new List<SelectListItem>
    {
        new("Default (inherit)", ""),
        new("Primary",   "text-primary"),
        new("Secondary", "text-secondary"),
        new("Success",   "text-success"),
        new("Danger",    "text-danger"),
        new("Warning",   "text-warning"),
        new("Info",      "text-info"),
        new("Body",      "text-body"),
        new("Muted",     "text-muted"),
    };
}

<!-- Field shell — data attributes wire the JS to API URL and sibling modal. -->
<div class="fa-icon-field mb-3"
     data-fa-field-id="@fieldId"
     data-fa-api-url="@Model.CuratedIconsApiUrl">

    <!-- Hidden input carries the canonical key value through the Orchard form binding. -->
    <input asp-for="IconKey" type="hidden" class="fa-icon-key-input" />

    <label class="form-label">Icon</label>

    <!-- Closed-state row: preview box + canonical key + action buttons. -->
    <div class="d-flex align-items-center gap-2 flex-wrap">

        <div class="border rounded p-2 d-flex align-items-center justify-content-center flex-shrink-0"
             style="min-width:3rem;min-height:3rem;"
             aria-hidden="true">
            <span class="fa-icon-preview-glyph fa-admin-icon-glyph"></span>
        </div>

        <span class="fa-icon-key-display text-muted small font-monospace">@Model.IconKey</span>

        <button type="button"
                class="btn btn-sm btn-secondary"
                data-bs-toggle="modal"
                data-bs-target="#@modalId">
            Choose icon
        </button>

        <button type="button"
                class="btn btn-sm btn-link text-danger p-0 fa-icon-closed-clear @(hasValue ? "" : "d-none")">
            Clear
        </button>

    </div>

    @if (Model.AllowSizeSelection)
    {
        <div class="mt-2" style="max-width:18rem;">
            <label asp-for="Size" class="form-label">Size</label>
            <select asp-for="Size" asp-items="sizeOptions" class="form-select form-select-sm"></select>
        </div>
    }

    @if (Model.AllowColorSelection)
    {
        <div class="mt-2" style="max-width:18rem;">
            <label asp-for="Color" class="form-label">Color</label>
            <select asp-for="Color" asp-items="colorOptions" class="form-select form-select-sm"></select>
        </div>
    }

</div>

<!-- Bootstrap modal — opened by the "Choose icon" button via data-bs-toggle. -->
<div class="modal fade"
     id="@modalId"
     tabindex="-1"
     role="dialog"
     aria-label="Choose icon">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Choose Icon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <!-- Current selection box. -->
                <div class="card mb-3">
                    <div class="card-body d-flex align-items-center gap-2">
                        <div class="border rounded p-2 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="min-width:3rem;min-height:3rem;"
                             aria-hidden="true">
                            <span class="fa-picker-selection-glyph fa-admin-icon-glyph"></span>
                        </div>
                        <span class="fa-picker-selection-key text-muted small font-monospace flex-grow-1"></span>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger fa-picker-modal-clear d-none">
                            Clear
                        </button>
                    </div>
                </div>

                <!-- Search input. -->
                <input type="search"
                       class="form-control mb-2 fa-picker-search"
                       placeholder="Search icons&hellip;"
                       aria-label="Search icons"
                       autocomplete="off" />

                <!-- Status line (loading / error / count). -->
                <div class="fa-picker-status text-muted small mb-2" aria-live="polite"></div>

                <!-- Results grid — populated by fa-icon-picker.js. -->
                <div class="fa-picker-results"
                     role="listbox"
                     aria-label="Icon results"
                     style="max-height:20rem;overflow-y:auto;">
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fa-picker-apply">Apply</button>
            </div>

        </div>
    </div>
</div>




